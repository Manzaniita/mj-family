# ---------------------------------------------------------------------------
# Dependencias
# ---------------------------------------------------------------------------
node_modules/
vendor/

# ---------------------------------------------------------------------------
# Paquetes generados
#
# Los .zip se rehacen en cualquier momento con tools/build-releases.ps1, así
# que no se versionan: se publican como Releases de GitHub, colgados de la
# etiqueta de cada versión.
#
# El manifiesto SÍ se versiona: deja registrado qué versión y qué SHA-256 se
# subió a cada tienda, aunque el .zip ya no esté en la carpeta.
# ---------------------------------------------------------------------------
releases/*.zip

# ---------------------------------------------------------------------------
# Credenciales y configuración local
#
# Nunca deben llegar al repositorio: claves de WooCommerce, tokens, datos de
# conexión de cada tienda.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
auth.json
wp-config.php
wp-config-local.php

# ---------------------------------------------------------------------------
# Copias y volcados
# ---------------------------------------------------------------------------
*.sql
*.sql.gz
*.tar
*.tar.gz
*.bak
*.orig
_backup/
_zips/

# ---------------------------------------------------------------------------
# Informes de la verificacion
#
# Se rehacen cada vez que corre tools/verificar.ps1 o el CI. Lo que SI se
# versiona es tools/phpcs-baseline.json, que es la foto de referencia contra
# la que se compara.
# ---------------------------------------------------------------------------
phpcs.json
phpcs.csv

# ---------------------------------------------------------------------------
# Herramientas y desarrollo
# ---------------------------------------------------------------------------
.vite-running
.cache/
.parcel-cache/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---------------------------------------------------------------------------
# Editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "position": {
      "sticky": true,
      "fixed": true
    },
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultPalette": false,
      "gradients": [
        {
          "slug": "blue-to-cyan",
          "gradient": "linear-gradient(135deg, #0284c7 0%, #06b6d4 100%)",
          "name": "Azul a Cian Eléctrico"
        },
        {
          "slug": "ocean-depth",
          "gradient": "linear-gradient(135deg, #0b192c 0%, #1e3a8a 50%, #0284c7 100%)",
          "name": "Profundidad Océano"
        },
        {
          "slug": "aqua-ice",
          "gradient": "linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%)",
          "name": "Agua Hielo Suave"
        }
      ],
      "palette": [
        {
          "slug": "base",
          "color": "#f0f7fc",
          "name": "Fondo General (Base Hielo)"
        },
        {
          "slug": "surface",
          "color": "#ffffff",
          "name": "Superficie de Tarjetas"
        },
        {
          "slug": "surface-alt",
          "color": "#e0f2fe",
          "name": "Superficie Azul Suave"
        },
        {
          "slug": "contrast",
          "color": "#0c1a2e",
          "name": "Texto Principal (Azul Marino Profundo)"
        },
        {
          "slug": "muted",
          "color": "#475569",
          "name": "Texto Secundario"
        },
        {
          "slug": "primary",
          "color": "#0284c7",
          "name": "Color Primario (Azul Real)"
        },
        {
          "slug": "secondary",
          "color": "#0ea5e9",
          "name": "Color Secundario (Cian Cielo)"
        },
        {
          "slug": "aqua",
          "color": "#06b6d4",
          "name": "Agua / Turquesa"
        },
        {
          "slug": "accent",
          "color": "#06b6d4",
          "name": "Acento Agua / Destacado"
        },
        {
          "slug": "success",
          "color": "#10b981",
          "name": "Éxito / Transferencia"
        },
        {
          "slug": "warning",
          "color": "#ea580c",
          "name": "Oferta / Urgencia"
        },
        {
          "slug": "border",
          "color": "#dbeafe",
          "name": "Bordes y Divisores (Azul Glaciar)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Inter / Sistema Moderno",
          "slug": "body"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif",
          "name": "Plus Jakarta Sans (Títulos)",
          "slug": "heading"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "Extra Chico"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Chico"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "lg",
          "size": "1.25rem",
          "name": "Grande"
        },
        {
          "slug": "xl",
          "size": "1.65rem",
          "name": "Extra Grande"
        },
        {
          "slug": "2xl",
          "size": "2.25rem",
          "name": "Título Destacado"
        },
        {
          "slug": "3xl",
          "size": "3rem",
          "name": "Hero Display"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "1.25rem",
        "bottom": "0px",
        "left": "1.25rem"
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "border": {
          "radius": "12px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Encabezado de Tienda (Header)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pie de Tienda (Footer + Barra Móvil)",
      "area": "footer"
    },
    {
      "name": "product-card-extras",
      "title": "Extras de Tarjeta de Producto (Transferencia/Cuotas)",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "front-page",
      "title": "Portada Modular E-Commerce (Inicio)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page",
      "title": "Página Estándar (Contacto, Mi Cuenta, Envíos, etc.)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "archive-product",
      "title": "Catálogo de Productos (WooCommerce)",
      "postTypes": [
        "product"
      ]
    },
    {
      "name": "single-product",
      "title": "Ficha de Producto Individual (WooCommerce)",
      "postTypes": [
        "product"
      ]
    },
    {
      "name": "page-cart",
      "title": "Carrito de Compras Editable",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-checkout",
      "title": "Checkout Editable por Pasos",
      "postTypes": [
        "page"
      ]
    }
  ]
}
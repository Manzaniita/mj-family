{
  "_comentario": [
    "Configuración de tools/build-releases.ps1. Todo lo que decide qué se",
    "empaqueta, qué se compila y qué queda afuera vive acá: el script no",
    "tiene ninguna ruta ni nombre fijo. Para sumar un plugin o un tema nuevo",
    "alcanza con crear su carpeta en plugins/ o themes/ — se detectan solos.",
    "",
    "  roots    — dónde buscar paquetes (cada subcarpeta = un paquete).",
    "  builds   — apps que hay que compilar antes de empaquetar. Cada una se",
    "             compila solo si el paquete que la contiene tiene versión nueva.",
    "  exclude  — patrones que NUNCA entran al zip (código fuente, dependencias).",
    "  bundles  — qué zip lleva cada tienda. Solo se listan al final de la",
    "             corrida: no se copia ni se arma ninguna carpeta.",
    "  output   — carpeta de salida."
  ],

  "output": "releases",

  "roots": [
    { "path": "themes",  "type": "theme"  },
    { "path": "plugins", "type": "plugin" }
  ],

  "builds": [
    {
      "name": "MJ Appearance (SPA del tema)",
      "path": "themes/mj-appearance/react-app",
      "install": "npm ci --no-audit --no-fund",
      "build": "npm run build",
      "produces": "themes/mj-appearance/dist/index.html"
    },
    {
      "name": "MJ Turnos Online (app de reservas)",
      "path": "plugins/mj-turnos-online/app",
      "install": "npm ci --no-audit --no-fund",
      "build": "npm run build",
      "produces": "plugins/mj-turnos-online/dist/app.js"
    }
  ],

  "exclude": [
    "node_modules",
    "react-app",
    "app",
    ".git",
    ".github",
    ".codex",
    ".codex-log",
    ".claude",
    "AGENTS.md",
    "AGENTS.override.md",
    "CLAUDE.md",
    ".vscode",
    ".idea",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".vite-running",
    ".DS_Store",
    "Thumbs.db",
    "*.map",
    "*.log",
    "*.zip",
    "*.psd",
    "*.ai"
  ],

  "bundles": {
    "glossyhair": {
      "label": "GlossyHair — salón de alisados con turnos y venta de productos",
      "packages": [
        "mj-core",
        "mj-appearance",
        "mj-glossyhair",
        "mj-turnos-online",
        "mj-medios-pago",
        "mj-envios",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    },
    "yamana": {
      "label": "Yamana — tejidos artesanales con el proyecto colectivo Entre Hilos",
      "packages": [
        "mj-core",
        "mj-appearance",
        "mj-yamana",
        "mj-colegas",
        "mj-medios-pago",
        "mj-envios",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    },
    "atelier": {
      "label": "MJ Atelier — tienda editorial con dólar, medios de pago y ERP",
      "packages": [
        "mj-core",
        "mj-appearance",
        "mj-atelier",
        "mj-dolar",
        "mj-medios-pago",
        "mj-envios",
        "mj-erp",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    },
    "jazbeauty": {
      "label": "Jaz Beauty Art — pestañas y cejas: turnos con seña, fidelidad y Beauty Shop",
      "packages": [
        "mj-core",
        "mj-appearance",
        "mj-jazbeauty",
        "mj-turnos-online",
        "mj-fidelidad",
        "mj-medios-pago",
        "mj-envios",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    },
    "proskin": {
      "label": "MJ ProSkin — tienda interactiva de ultralujo con WooCommerce y FSE",
      "packages": [
        "mj-core",
        "mj-appearance",
        "mj-proskin",
        "mj-medios-pago",
        "mj-envios",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    },
    "importaciones": {
      "label": "MJ Importaciones — tienda de importados y tecnología con MJ Commerce Pro FSE",
      "packages": [
        "mj-core",
        "mj-commerce-pro",
        "mj-dolar",
        "mj-medios-pago",
        "mj-envios",
        "mj-erp",
        "mj-optimizador-imagenes",
        "mj-fotos-rapidas",
        "mj-popup",
        "mj-instagram"
      ]
    }
  }
}

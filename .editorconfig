# Formato para archivos nuevos; respetar el estilo del bloque al editar código existente.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,js,jsx,css}]
indent_style = space
indent_size = 2

[*.php]
indent_style = tab
indent_size = 4

[*.ps1]
# Windows PowerShell 5.1 necesita BOM para interpretar acentos como UTF-8.
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
# Dos espacios finales pueden representar un salto de línea Markdown.
trim_trailing_whitespace = false
